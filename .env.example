# Токен Telegram-бота от @BotFather (создается бесплатно за 1 минуту)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Бесплатный ключ Google Gemini API из https://aistudio.google.com/app/apikey
# Если ключа нет, бот всё равно работает и аккуратно выводит описания!
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
